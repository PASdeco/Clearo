# Clearo service configuration. Copy these names into your environment
# (for the hosted deployment, set them in your host's environment settings).
# Secret values are marked; never commit a real secret to this repository.

# Relay app API key. Server-side only. Secret.
RELAY_API_KEY=

# Optional: comma separated Relay signing keys for webhook verification
# during key rotation. Falls back to RELAY_API_KEY when unset. Secret.
RELAY_WEBHOOK_KEYS=

# Clearo fee in basis points (25 = 0.25%), printed on every invoice.
CLEARO_FEE_BPS=25

# EVM address that receives the Clearo fee.
CLEARO_FEE_RECIPIENT=

# EVM address controlled by the operator, used as the recovery address
# on deposit-address quotes.
CLEARO_RECOVERY_ADDRESS=

# Directory holding the invoice store and the settlement ledger.
CLEARO_DATA_DIR=data

# Optional: JSON map of seller id to access token for the self-serve
# POST /invoices surface, for example {"my-seller": "a-long-random-token"}. Secret.
CLEARO_SELLER_TOKENS=
